# ==========================================
# M45 Auto QC Platform - .gitignore
# ==========================================

# 1. Dependencies (Node.js & Python)
node_modules/
**/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/

# 2. Build outputs & runtime caches
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
.cache/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 3. Heavy datasets, archives & point clouds
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.pcd
*.bin
*.npy
uploaded_dataset.zip
**/uploaded_dataset.zip
uploaded_dataset/
**/uploaded_dataset/
uploaded_data/
**/uploaded_data/
data/
**/data/

# 4. Environment configs & secrets
.env
.env.*
.env.local
!.env.example
*.local
cvat_saved_config.json
**/cvat_saved_config.json

# 5. OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
