# Copy thành backend/.env rồi điền thông tin CVAT Local của bạn.

# URL mà BACKEND dùng để gọi CVAT REST API
CVAT_URL=http://localhost:8080
# URL mà TRÌNH DUYỆT dùng cho nút "Mở CVAT Local" (thường giống CVAT_URL khi chạy WSL)
CVAT_PUBLIC_URL=http://localhost:8080

# Xác thực: dùng token HOẶC username/password (basic auth)
CVAT_TOKEN=
# "Token" cho key lấy từ POST /api/auth/login, "Bearer" cho Personal Access Token
CVAT_AUTH_SCHEME=Token
CVAT_USERNAME=
CVAT_PASSWORD=
# Nếu task nằm trong Organization
CVAT_ORG=

# Task 3D mặc định khi mở Workstation ("demo" = Zero-Config Demo)
CVAT_TASK_ID=demo

# Bắt buộc chạy demo kể cả khi CVAT đang bật (0/1)
M45_FORCE_DEMO=0

# Tham số thuật toán M45
M45_Z_CUTOFF=-1.0
M45_HEIGHT_COLLAPSE_M=0.05
M45_ZCUT_DEFECT_RATIO=0.6
M45_SOTIF_SPEED_KMH=50
M45_SOTIF_REACTION_S=0.8
M45_SOTIF_DECEL_MPS2=6.0
M45_LIDAR_EFFICIENCY=0.35
M45_MAX_POINTS_TRANSFER=60000

M45_PORT=8088
M45_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
